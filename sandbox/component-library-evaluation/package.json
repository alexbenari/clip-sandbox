{
  "name": "clip-sandbox-panel-pilot",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run typecheck && node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:panel": "npm run build && node check-panel.mjs",
    "test:grid": "npm run build && node check-grid.mjs",
    "test:motion": "npm run build && node probe-split-panel.mjs",
    "test:popover": "npm run build && node check-popover.mjs",
    "test:popover-input": "npm run build && node check-popover-input.mjs",
    "test:spectrum": "npm run build && node check-spectrum.mjs",
    "test:spectrum-timing": "npm run build && node check-spectrum-timing.mjs",
    "start:spectrum": "npm run build && electron launch.cjs --spectrum",
    "test:shell": "npm run build && node check-shell.mjs",
    "test:shell-overlay": "npm run build && node check-shell.mjs --title-overlay",
    "start:shell": "npm run build && electron launch.cjs --shell",
    "start:shell-overlay": "npm run build && electron launch.cjs --shell --title-overlay",
    "start": "npm run build && electron launch.cjs"
  },
  "dependencies": {
    "@awesome.me/webawesome": "3.12.0",
    "@spectrum-web-components/overlay": "1.12.2",
    "@spectrum-web-components/popover": "1.12.2",
    "@spectrum-web-components/theme": "1.12.2"
  }
}
