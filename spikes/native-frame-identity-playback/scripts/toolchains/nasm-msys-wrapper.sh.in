#!/usr/bin/env bash
set -e

NATIVE_NASM='@NATIVE_NASM@'
NATIVE_SOURCE_PATH='@NATIVE_SOURCE_PATH@'
ARGS=()
for ARG in "$@"; do
    case "$ARG" in
        src/*)
            ARG="${NATIVE_SOURCE_PATH}/${ARG#src/}"
            ;;
        -Isrc/*)
            ARG="-I${NATIVE_SOURCE_PATH}/${ARG#-Isrc/}"
            ;;
    esac

    case "$ARG" in
        */cygdrive/*)
            PREFIX="${ARG%%/cygdrive/*}"
            REST="${ARG#*/cygdrive/}"
            DRIVE="${REST%%/*}"
            TAIL="${REST#*/}"
            ARGS+=("${PREFIX}${DRIVE^^}:/${TAIL}")
            ;;
        *)
            ARGS+=("$ARG")
            ;;
    esac
done

exec "$NATIVE_NASM" "${ARGS[@]}"
